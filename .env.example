# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./traffic_monitor.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security (add when implementing authentication)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Server Configuration
AI_SERVER_URL=http://localhost:5000/worker/inference
AI_MAX_CONCURRENT_REQUESTS=1

# Video Processing Configuration
DEFAULT_BATCH_SIZE=7
DEFAULT_SLIDING_WINDOW=1

# Video Upload Configuration
UPLOAD_DIR=./uploads/videos
MAX_VIDEO_SIZE_MB=500
MAX_UPLOAD_SPEED_MB_PER_SEC=10
